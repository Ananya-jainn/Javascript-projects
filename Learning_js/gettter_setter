console.log(ananya.email);


//property based
function User(email,password){
    this._email = email;
    this._pass = password

    Object.defineProperty(this,'email',{
        get: function(){
            return this._email.toUpperCase()
        },
        set : function(value){
            this.email = value
        }})
    Object.defineProperty(this,'password',{
        get: function(){
            return this._password.toUpperCase()
        },
        set : function(value){
            this.password = value
        }})
}


